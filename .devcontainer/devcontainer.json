{
    "name": "Book Scraper Dev Environment",
    "dockerComposeFile": "../docker-compose.yml",
    "features": {
        "ghcr.io/devcontainers/features/docker-in-docker:latest": {
        },
        "ghcr.io/devcontainers/features/terraform:1": {
            "version": "latest"
        },
        "ghcr.io/devcontainers/features/aws-cli:1": {
        "version": "latest"
        }
    },
    "service": "scraper",
    "workspaceFolder": "/app",
    "customizations": {
        "vscode": {
            "extensions": ["ms-python.python", "ckolkman.vscode-postgres", "tamasfe.even-better-toml", "hashicorp.terraform"]
        }
    },
    "remoteUser": "root",
    "containerUser": "root",
    "postCreateCommand": ""
}